# ==============================================================================
# Corona International Concepts Limited (CICL)
# Static Website Apache Hardening & Security Configuration
# ==============================================================================

# Disable Directory Browsing
Options -Indexes

# 1. SECURITY: Completely Disable PHP Execution
# This ensures that even if an attacker manages to upload a .php script,
# Apache will NOT execute it under any circumstance!
<FilesMatch "\.(php|php3|php4|php5|phtml|pl|py|jsp|asp|htm|shtml|sh|cgi)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Allow only static files (.html, .css, .js, images, fonts, video, pdf, xml, txt, json)
<FilesMatch "\.(html|htm|css|js|png|jpg|jpeg|gif|webp|svg|ico|woff|woff2|ttf|eot|xml|txt|json|mp4|webm|ogv|pdf)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Allow from all
    </IfModule>
</FilesMatch>

# 2. Block WordPress Malware / Injection URLs
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Return 410 Gone for old WordPress malware URLs (/item/xxxx, /wp-admin/, /wp-login.php, xmlrpc.php)
    RewriteRule ^item/ - [G,L]
    RewriteRule ^wp-admin/ - [F,L]
    RewriteRule ^wp-login\.php$ - [F,L]
    RewriteRule ^xmlrpc\.php$ - [F,L]

    # Clean URL support: allow /about to serve /about.html
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^([^/]+)/?$ $1.html [L]

    # Custom 404
    ErrorDocument 404 /404.html
</IfModule>

# 3. Security Headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Gzip / Deflate Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# 5. Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/html "access plus 1 hour"
</IfModule>
